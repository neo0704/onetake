# Copy this file to .env and fill in real values. Never commit the real .env.

# Backend origin (not the /api-prefixed base) — used for sockets and building
# image URLs like avatars: `${VITE_SOCKET_URL}/uploads/avatars/...`
VITE_SOCKET_URL=http://localhost:5000

# REST API base — note this one DOES include /api, unlike VITE_SOCKET_URL above.
# Read by services/api.js for every axios request.
VITE_API_URL=http://localhost:5000/api
