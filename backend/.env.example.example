# Copy this file to .env and fill in real values. Never commit the real .env.

# MongoDB Atlas connection string — must be named MONGODB_URI, not MONGO_URI,
# to match what backend/src/config/db.js actually reads
MONGODB_URI=

# Long random string used to sign JWTs — generate one, don't reuse this example
JWT_SECRET=

# Email (Nodemailer / SMTP — Gmail shown as example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Your deployed frontend URL (used to build links inside notification emails)
CLIENT_URL=http://localhost:5173

# Port the backend listens on
PORT=5000